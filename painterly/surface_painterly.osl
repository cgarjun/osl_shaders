// painterly_surface.osl
// A painterly / "painted concept art" surface shader.
//
// Look goals:
//  - Soft but deliberate light/shadow split, with a broken, brushy terminator
//  - Warm, saturated band along the terminator (painted "bleed")
//  - Cool, hue-shifted shadows instead of just darker base color
//  - Sky fill + cool rim light breaking up the silhouette
//  - Shaped, slightly blocky painted highlight
//  - Per-stroke value/hue jitter and low-frequency color variation
//  - Soft dark contour toward silhouettes
//
// Written for Blender Cycles (Script node, OSL enabled). Output is an
// emission closure, so set the scene's View Transform to "Standard" if
// you want the colors you pick to come out unchanged.

#include "stdosl.h"

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

float fbm(point p, int octaves)
{
    float sum = 0.0;
    float amp = 0.5;
    point q = p;
    for (int i = 0; i < octaves; i++) {
        sum += amp * noise("perlin", q);   // signed, roughly [-1, 1]
        q *= 2.03;
        amp *= 0.5;
    }
    return sum;
}

// Directional brush-stroke field.
// Returns a signed value (~[-1,1]) describing paint texture inside strokes,
// and writes a per-dab random value [0,1] to `dab`.
float stroke_field(point p, vector dir, float scale, float stretch,
                   float warp, output float dab)
{
    vector d = normalize(dir);
    vector helper = (abs(d[2]) < 0.95) ? vector(0, 0, 1) : vector(1, 0, 0);
    vector b1 = normalize(cross(d, helper));
    vector b2 = cross(d, b1);

    vector pv = vector(p);
    // Stroke space: long along d, short across it
    point q = point(dot(pv, d) / max(stretch, 0.001), dot(pv, b1), dot(pv, b2)) * scale;

    // Wobble the coordinates so dab edges are irregular, not grid-aligned
    vector w = vector(noise("perlin", q * 0.7 + vector(1.7, 9.2, 3.1)),
                      noise("perlin", q * 0.7 + vector(8.3, 2.8, 5.5)),
                      noise("perlin", q * 0.7 + vector(4.4, 7.1, 0.3)));
    q += warp * w;

    // One random value per brush dab
    dab = cellnoise(floor(q));

    // Body of the stroke plus fine bristle streaks running along it
    float body    = noise("perlin", q);
    float bristle = noise("perlin", point(q[0] * 0.5, q[1] * 9.0, q[2] * 9.0));
    return clamp(0.7 * body + 0.3 * bristle, -1.0, 1.0);
}

// ---------------------------------------------------------------------------
// Shader
// ---------------------------------------------------------------------------

shader PainterlySurface(
    // Base color
    color  BaseColor          = color(0.85, 0.58, 0.47),

    // Key light (world-space direction pointing TOWARD the light)
    vector LightDirection     = vector(0.4, -0.5, 0.75),
    color  LightColor         = color(1.0, 0.96, 0.88),
    float  LightOffset        = 0.0,     // push terminator: + = more lit
    float  Softness           = 0.06,    // width of light/shadow transition
    int    Bands              = 0,       // 0 = painted gradient, 2+ = posterized
    int    CastShadows        = 1,       // trace() toward the light
    float  ShadowBias         = 0.01,

    // Shadow painting
    color  ShadowTint         = color(0.62, 0.62, 0.95), // cool hue filter
    float  ShadowDarkness     = 0.45,

    // Warm terminator band
    color  TerminatorColor    = color(1.0, 0.45, 0.32),
    float  TerminatorWidth    = 0.15,
    float  TerminatorStrength = 0.45,

    // Sky fill + rim
    vector UpAxis             = vector(0, 0, 1),         // Blender is Z-up
    color  SkyColor           = color(0.35, 0.62, 1.0),
    float  SkyFill            = 0.25,
    float  RimWidth           = 0.3,
    float  RimStrength        = 0.35,

    // Painted highlight
    float  SpecSize           = 0.06,
    float  SpecStrength       = 0.35,

    // Brush strokes
    string StrokeSpace        = "object",
    vector StrokeDirection    = vector(1, 0.3, 0.2),
    float  StrokeScale        = 6.0,
    float  StrokeStretch      = 4.0,
    float  StrokeWarp         = 0.6,
    float  EdgeBreakup        = 0.12,    // how much strokes chew the terminator
    float  ValueJitter        = 0.06,
    float  HueJitter          = 0.02,
    float  LargeVariation     = 0.08,    // low-frequency color drift

    // Soft contour
    float  OutlineWidth       = 0.22,
    color  OutlineColor       = color(0.16, 0.09, 0.12),
    float  OutlineStrength    = 0.5,

    output closure color Out  = 0,
    output color  Col         = 0,
    output float  LightMask   = 0
)
{
    vector Nn = normalize(N);
    vector V  = normalize(-I);
    vector L  = normalize(transform("world", "common", LightDirection));
    vector Up = normalize(transform("world", "common", UpAxis));

    point Pstroke = transform(StrokeSpace, P);

    // --- Brush strokes: main direction + a weaker crossing layer ----------
    float dabA, dabB;
    float sA = stroke_field(Pstroke, StrokeDirection, StrokeScale, StrokeStretch,
                            StrokeWarp, dabA);
    vector crossDir = cross(normalize(StrokeDirection), vector(0.3, 0.9, 0.2));
    float sB = stroke_field(Pstroke + vector(13.1, 7.7, 2.9), crossDir,
                            StrokeScale * 1.7, StrokeStretch * 0.8,
                            StrokeWarp, dabB);
    float strokes = mix(sA, sB, 0.35);

    // Low-frequency variation (like a painter mixing slightly different paint)
    float large = fbm(Pstroke * (StrokeScale * 0.15), 3);

    // --- Light term ------------------------------------------------------
    float NdotL = dot(Nn, L);
    float lit = NdotL + LightOffset + strokes * EdgeBreakup + large * 0.05;

    float shadow = 1.0;
    if (CastShadows && NdotL > -0.2) {
        if (trace(P + Nn * ShadowBias, L))
            shadow = 0.0;
    }

    float light = smoothstep(-Softness, Softness, lit) * shadow;
    if (Bands > 1) {
        float b = float(Bands);
        light = floor(light * (b - 1.0) + 0.5) / (b - 1.0);
    }

    // --- Base lit / shadow colors ---------------------------------------
    color litCol    = BaseColor * LightColor;
    color shadowCol = BaseColor * ShadowTint * (1.0 - ShadowDarkness);

    color c = mix(shadowCol, litCol, light);

    // Warm, saturated band right along the terminator
    float term = 1.0 - smoothstep(0.0, TerminatorWidth, abs(lit));
    term *= shadow;
    c = mix(c, BaseColor * TerminatorColor * 1.2, term * TerminatorStrength);

    // Sky bounce into upward-facing shadow areas
    float skyAmt = (dot(Nn, Up) * 0.5 + 0.5) * SkyFill * (1.0 - light);
    c += SkyColor * BaseColor * skyAmt;

    // --- Rim: cool sky light catching the silhouette, broken by strokes ---
    float facing = clamp(dot(Nn, V), 0.0, 1.0);
    float rim = smoothstep(1.0 - RimWidth, 1.0, 1.0 - facing);
    rim *= smoothstep(-0.3, 0.3, strokes);
    c = mix(c, SkyColor * mix(BaseColor, color(1), 0.5), rim * RimStrength);

    // --- Painted highlight: hard-ish shape, wobbled by strokes ------------
    vector H = normalize(L + V);
    float sp = dot(Nn, H) + strokes * 0.03;
    float spec = smoothstep(1.0 - SpecSize, 1.0 - SpecSize + 0.02, sp);
    c += LightColor * spec * SpecStrength * shadow;

    // --- Per-dab value/hue jitter + large variation ----------------------
    float dab = mix(dabA, dabB, 0.35);
    c *= 1.0 + (dab - 0.5) * 2.0 * ValueJitter + large * LargeVariation;

    color hsv = transformc("rgb", "hsv", c);
    hsv[0] = mod(hsv[0] + (dab - 0.5) * 2.0 * HueJitter + large * HueJitter, 1.0);
    c = transformc("hsv", "rgb", hsv);

    // --- Soft contour toward the silhouette ------------------------------
    float edge = 1.0 - smoothstep(OutlineWidth * 0.4, OutlineWidth,
                                  facing + strokes * 0.05);
    c = mix(c, OutlineColor, edge * OutlineStrength);

    c = max(c, color(0));

    Col = c;
    LightMask = light;
    Out = c * emission();
}
